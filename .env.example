# New AIHub key: used ONLY for Gemini understanding.
AIHUB_API_KEY=
UNDERSTANDING_PROVIDER=aihub-gemini
GEMINI_MODEL=gemini-3.8-flash
GEMINI_API_URL=http://api.aihub.woa.com/standard/v1/chat/completions
GEMINI_REASONING_EFFORT=low
GEMINI_MIN_OUTPUT_TOKENS=4096
GEMINI_TIMEOUT_SECONDS=120

# Legacy AIHub credentials: Doubao ASR, editorial review and Doubao/MiMo speech.
APP_ID=
APP_KEY=

# Optional rendering font overrides; install a Chinese-capable font on your OS.
# SUBTITLE_FONT_NAME=Noto Sans CJK SC
# SUBTITLE_FONTS_DIR=/path/to/fonts

# To compare with the previous understanding model, set:
# UNDERSTANDING_PROVIDER=aihub-doubao
